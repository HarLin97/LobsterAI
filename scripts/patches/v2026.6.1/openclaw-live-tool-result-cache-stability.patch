+    const prefix = [
+      makeToolResult("p".repeat(15_000), "prefix_1"),
+      makeToolResult("q".repeat(15_000), "prefix_2"),
+    ];
+    const suffix = [
+      makeToolResult("x".repeat(15_000), "current_1"),
